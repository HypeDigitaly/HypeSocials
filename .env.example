# HypeSocials secrets — copy this file to `.env` and fill in real values.
# Never commit `.env`. Keys go only into HTTP Authorization headers and per-server
# MCP env dicts; never into a config YAML, a prompt, a template, or a log line
# (30-configuration-and-run.md §2 Secrets handling, FR-177 / D30).

# Required — Virlo trend discovery (via the shipped stdio MCP wrapper).
# Virlo also requires a payment method + prepaid deposit before any call succeeds (OQ-19).
VIRLO_API_KEY=virlo_tkn_your_key_here

# Required — OpenRouter: Sonnet 5 style analysis + GPT 5.6 Luna copywriting.
OPENROUTER_API_KEY=sk-or-your_key_here

# Required — Kie.ai: GPT Image 2 + Seedance 2.5 renders and file uploads.
KIE_API_KEY=your_kie_key_here

# Phase 2 only — Postiz publishing; sent raw in the Authorization header, no "Bearer" prefix (FR-226).
POSTIZ_API_KEY=your_postiz_key_here
# Phase 2, optional — Postiz base URL; unset means the hosted default https://api.postiz.com/public/v1
# (60-publishing FR-225). Uncomment only for a self-hosted instance; never a refusal when absent.
#POSTIZ_BASE_URL=https://api.postiz.com/public/v1

# Local-only salt used when hashing creator handles written to logs/history — never sent to any provider.
HANDLE_HASH_KEY=any_random_local_string

# Optional — Notion brand context; needed only for notion_influence: copy | full (FR-122).
# Each configured page must be shared with the integration once in Notion's UI (FR-123).
NOTION_TOKEN=ntn_your_integration_token_here
